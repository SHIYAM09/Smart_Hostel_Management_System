          }
        },
        {
          "name": "File New Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Water Leakage in A-101\",\n  \"description\": \"Bathroom pipe leaking continuously\",\n  \"category\": \"Plumbing\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": { "raw": "{{main_url}}/complaints", "host": ["{{main_url}}"], "path": ["complaints"] }
          }
        },
        {
          "name": "Update Complaint Status (Warden)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{main_url}}/complaints/1/status?status=RESOLVED",
              "host": ["{{main_url}}"],
              "path": ["complaints", "1", "status"],
              "query": [{ "key": "status", "value": "RESOLVED" }]
            }
          }
        },
        {
          "name": "Submit Complaint Feedback (Student)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{main_url}}/complaints/1/feedback?rating=5&comment=Fixed%20promptly",
              "host": ["{{main_url}}"],
              "path": ["complaints", "1", "feedback"],
              "query": [
                { "key": "rating", "value": "5" },
                { "key": "comment", "value": "Fixed promptly" }
              ]
            }
          }
        }
      ]
