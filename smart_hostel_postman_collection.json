{
  "info": {
    "name": "Smart Hostel Management System - Complete API Collection",
    "description": "Comprehensive Postman Collection for Authentication Service (Port 8081 - Oracle XE / Auth) and Main Hostel Management Service (Port 8082 - MongoDB / Authorization). Includes User Registration, Login, Dashboards, and full CRUD endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "auth_url", "value": "http://localhost:8081/api/v1", "type": "string" },
    { "key": "main_url", "value": "http://localhost:8082/api/v1", "type": "string" },
    { "key": "token", "value": "YOUR_JWT_BEARER_TOKEN_HERE", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication Service (Port 8081)",
      "item": [
        {
          "name": "Register New User (Student / Warden / Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newstudent\",\n  \"email\": \"student@hostel.edu\",\n  \"password\": \"password123\",\n  \"fullName\": \"New Student Name\",\n  \"phone\": \"9876543210\",\n  \"roles\": [\"STUDENT\"]\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/register", "host": ["{{auth_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (Admin / Warden / Student)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/login", "host": ["{{auth_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{auth_url}}/auth/me", "host": ["{{auth_url}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"admin123\",\n  \"newPassword\": \"admin456\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/change-password", "host": ["{{auth_url}}"], "path": ["auth", "change-password"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{auth_url}}/auth/logout", "host": ["{{auth_url}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
