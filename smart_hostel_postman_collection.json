              "raw": "{\n  \"fullName\": \"Arjun Sharma\",\n  \"rollNumber\": \"22CS001\",\n  \"department\": \"CSE\",\n  \"yearOfStudy\": 2,\n  \"hostelBlock\": \"Block A\",\n  \"roomNumber\": \"A-101\",\n  \"phone\": \"9876543210\",\n  \"email\": \"arjun@student.edu\",\n  \"status\": \"ACTIVE\"\n}"
