{
  "info": {
    "name": "Smart Hostel Management System - Complete API Collection (75 APIs)",
    "description": "Enterprise Postman Collection containing all 75 REST API endpoints across Authentication Service (Port 8081 - Oracle XE) and Authorization Service (Port 8082 - MongoDB).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "auth_url", "value": "http://localhost:8081/api/v1", "type": "string" },
    { "key": "main_url", "value": "http://localhost:8082/api/v1", "type": "string" },
    { "key": "token", "value": "YOUR_JWT_BEARER_TOKEN_HERE", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication Service (Port 8081 - Oracle XE)",
      "item": [
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/login", "host": ["{{auth_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "User Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student01\",\n  \"email\": \"student01@hostel.edu\",\n  \"password\": \"student123\",\n  \"fullName\": \"Rahul Verma\",\n  \"phone\": \"9876543210\",\n  \"roles\": [\"STUDENT\"]\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/register", "host": ["{{auth_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Get Logged-in User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{auth_url}}/auth/me", "host": ["{{auth_url}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"admin123\",\n  \"newPassword\": \"admin456\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/change-password", "host": ["{{auth_url}}"], "path": ["auth", "change-password"] }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"YOUR_REFRESH_TOKEN_HERE\"\n}"
            },
            "url": { "raw": "{{auth_url}}/auth/refresh-token", "host": ["{{auth_url}}"], "path": ["auth", "refresh-token"] }
          }
        },
